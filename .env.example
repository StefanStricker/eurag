# Models served by Ollama (pulled automatically on first start)
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=snowflake-arctic-embed2
EMBED_DIM=1024

# Retrieval / generation
TOP_K=8
# dense, or hybrid (dense + BM25 with RRF fusion; no article bonus)
RETRIEVAL_MODE=dense
# Cross-encoder reranking of the search candidates (GPU). On 8 GB also set QUERY_EMBED_NUM_GPU=0 (query
# embeddings on the CPU) and LLM_NUM_GPU=99 (all LLM layers on the GPU), else Ollama offloads LLM layers.
RERANK=false
NUM_CTX=8192
ANSWER_TOKENS=1024
TEMPERATURE=0

# Host ports
API_PORT=8000
QDRANT_PORT=6333
OLLAMA_PORT=11434
